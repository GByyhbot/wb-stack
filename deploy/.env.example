# deploy/.env 只需保存鉴权变量（compose 会读取），SSH 主机/密码走环境变量，不落盘
# 首次部署留空即可，deploy.py 会生成 32 字节随机密钥并写入 .env
MANAGER_USER=wbadmin
MANAGER_PASSWORD=
ROTATOR_KEY=

# 可选：deploy.py 的目标主机覆盖（默认见脚本 DEFAULTS）
# ECS_HOST=192.168.31.95
# ECS_USER=Yyh154019
# REMOTE_DIR=/vol1/1000/apps/wb-stack
# REMOTE_SUDO=1

# 单容器监听 8300(管理后台) / 8310(OpenAI 网关)，与项目原端口一致
